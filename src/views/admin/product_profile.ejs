<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>
    <%= product.name %>
  </title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
</head>

<body>





  <!-- Main Layout Container -->
  <div class="d-flex min-vh-100">

      <%- include('./sidebar.ejs') %>



        <main class="main-content flex-grow-1 p-3 p-md-4 overflow-hidden bg-light">

            
    
        <div class="d-flex justify-content-between align-items-start align-items-md-center flex-wrap gap-3 mb-4">
      <div>
        <h3 class="fw-bold mb-1 fs-4 fs-md-3">Product Profile</h3>
        <p class="text-secondary mb-0 small">
          Detailed view and management for <%= product.name %>
        </p>
      </div>

      <a href="/product/products" class="btn btn-primary btn-sm btn-md-regular d-flex align-items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewBox="0 0 16 16">
          <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8" />
        </svg>
        Back to Products
      </a>
    </div>

    <!-- Product Details Content Grid -->
    <div class="row g-4">

      <!-- Left Column: Image & Quick Pricing Card -->
      <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-body text-center p-4">
            <img src="<%= product.main_image %>" alt="<%= product.name %>" class="img-fluid rounded mb-3 object-fit-contain" style="max-height: 250px; width: 100%;">
            <div class="d-flex justify-content-center align-items-center gap-2 mb-2">
              <span class="badge bg-<%= product.status === 'active' ? 'success' : 'secondary' %> text-uppercase">
                <%= product.status %>
              </span>
              <% if (product.is_featured) { %>
              <span class="badge bg-warning text-dark">Featured</span>
              <% } %>
            </div>
            <h5 class="fw-bold mb-1">
              <%= product.name %>
            </h5>
            <p class="text-secondary small mb-3">SKU: <%= product.sku %> | Brand: <%= product.brand %>
            </p>

            <!-- Pricing -->
            <div class="bg-light p-3 rounded d-flex justify-content-around align-items-center">
              <div>
                <small class="text-secondary d-block">Price</small>
                <span class="fs-4 fw-bold text-primary">₹<%= product.price %></span>
              </div>
              <div class="border-start ps-3">
                <small class="text-secondary d-block">MRP</small>
                <span class="text-decoration-line-through text-muted">₹<%= product.mrp %></span>
              </div>
              <div class="border-start ps-3">
                <small class="text-secondary d-block">Discount</small>
                <span class="badge bg-danger">
                  <%= product.discount %>% OFF
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Seller Information Card -->
        <div class="card border-0 shadow-sm">
          <div class="card-header bg-white py-3">
            <h6 class="mb-0 fw-bold"><i class="bi bi-shop me-2 text-primary"></i>Seller Information</h6>
          </div>
          <div class="card-body">
            <p class="mb-1 fw-semibold">
              <%= product.seller ? product.seller.name : 'N/A' %>
            </p>
            <p class="text-secondary small mb-0">GST No: <%= product.seller && product.seller.gst_no ?
                                product.seller.gst_no : 'Not Provided' %>
            </p>
          </div>
        </div>
      </div>

      <!-- Right Column: Descriptions & Detailed Specifications -->
      <div class="col-12 col-lg-8">

        <!-- Descriptions Card -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold fs-5">Product Description</h5>
          </div>
          <div class="card-body">
            <h6 class="fw-bold text-secondary small text-uppercase">Short Description</h6>
            <p class="text-muted">
              <%= product.short_description %>
            </p>

            <h6 class="fw-bold text-secondary small text-uppercase mt-3">Full Description</h6>
            <p class="text-muted mb-0">
              <%= product.description %>
            </p>
          </div>
        </div>

        <!-- Specifications Table Card -->
        <div class="card border-0 shadow-sm mb-4">
          <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold fs-5">Specifications & Inventory</h5>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-striped mb-0 align-middle">
                <tbody>
                  <tr>
                    <td class="fw-semibold ps-3">Category</td>
                    <td class="text-capitalize">
                      <%= product.category %>
                    </td>
                  </tr>
                  <tr>
                    <td class="fw-semibold ps-3">Stock Available</td>
                    <td>
                      <span class="badge bg-<%= product.stock > 0 ? 'success' : 'danger' %>">
                        <%= product.stock %>
                        <%= product.unit %>s
                      </span>
                    </td>
                  </tr>
                  <tr>
                    <td class="fw-semibold ps-3">Weight</td>
                    <td>
                      <%= product.weight %> kg
                    </td>
                  </tr>
                  <tr>
                    <td class="fw-semibold ps-3">Warranty</td>
                    <td>
                      <%= product.warranty_months %> Months
                    </td>
                  </tr>
                  <tr>
                    <td class="fw-semibold ps-3">Return Policy</td>
                    <td>
                      <%= product.refund.exists ? `${product.refund.days} Days Returnable`
                                                : 'No Returns' %>
                    </td>
                  </tr>
                  <tr>
                    <td class="fw-semibold ps-3">Tags</td>
                    <td>
                      <% product.tags.forEach(tag=> { %>
                      <span class="badge bg-secondary me-1">
                        <%= tag %>
                      </span>
                      <% }) %>
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

      </div>

    </div>

    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4" crossorigin="anonymous"></script>
</body>

</html>