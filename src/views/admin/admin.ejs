<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Admin Management | MyZone</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

</head>

<body class="bg-light">

    <!-- Main Layout -->
    <div class="d-flex min-vh-100">

        <!-- Sidebar -->
        <%- include('./sidebar.ejs') %>

            <!-- Main Content -->
            <main class="main-content flex-grow-1 p-3 p-md-4">

                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

                    <div>
                        <h3 class="fw-bold mb-1">Admin Management</h3>
                        <p class="text-secondary mb-0">
                            Manage all platform administrators.
                        </p>
                    </div>

                    <a href="/superadmin/admins/create" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>
                        Add Administrator
                    </a>

                </div>

                <!-- Statistics -->
                <div class="row g-3 mb-4">

                    <div class="col-12 col-md-4">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <small class="text-secondary">Total Administrators</small>
                                <h3 class="fw-bold mb-0">
                                    <%= admins.length %>
                                </h3>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <small class="text-secondary">Active Administrators</small>
                                <h3 class="fw-bold mb-0">
                                    <%= admins.filter(admin=> admin.status === "active").length %>
                                </h3>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body">
                                <small class="text-secondary">Inactive Administrators</small>
                                <h3 class="fw-bold mb-0">
                                    <%= admins.filter(admin=> admin.status === "inactive").length %>
                                </h3>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Admin Table -->
                <div class="card border-0 shadow-sm">

                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0 fw-bold">All Administrators</h5>
                    </div>

                    <div class="card-body">

                        <div class="table-responsive">

                            <table class="table table-hover align-middle">

                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Administrator</th>
                                        <th>Email</th>
                                        <th>Status</th>
                                        <th>Created At</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    <% if (admins.length> 0) { %>

                                        <% admins.forEach((admin, index)=> { %>

                                            <tr>

                                                <td>
                                                    <%= index + 1 %>
                                                </td>

                                                <td>
                                                    <div class="fw-semibold">
                                                        <%= admin.name %>
                                                    </div>
                                                </td>

                                                <td>
                                                    <%= admin.email %>
                                                </td>



                                                <td>
                                                    <% if (admin.isActive==="active" ) { %>
                                                        <span class="badge bg-success">
                                                            Active
                                                        </span>
                                                        <% } else { %>
                                                            <span class="badge bg-danger">
                                                                Inactive
                                                            </span>
                                                            <% } %>
                                                </td>

                                                <td>
                                                    <%= admin.createdAt ? new Date(admin.createdAt).toLocaleDateString()
                                                        : "N/A" %>
                                                </td>

                                                <td>
                                                    <div class="d-flex gap-2">

                                                        <a href="/admin/admin/<%= admin._id %>"
                                                            class="btn btn-sm btn-outline-primary" title="View">
                                                            <i class="bi bi-eye"></i>
                                                        </a>

                                                        <a href="/admin/admin/<%= admin._id %>/edit"
                                                            class="btn btn-sm btn-outline-warning" title="Edit">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>

                                                        <form action="/admin/admin/<%= admin._id %>/delete"
                                                            method="POST"
                                                            onsubmit="return confirm('Are you sure you want to delete this administrator?')">

                                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                                title="Delete">
                                                                <i class="bi bi-trash"></i>
                                                            </button>

                                                        </form>

                                                    </div>
                                                </td>

                                            </tr>

                                            <% }); %>

                                                <% } else { %>

                                                    <tr>
                                                        <td colspan="7" class="text-center py-5">

                                                            <i class="bi bi-people fs-1 text-secondary"></i>

                                                            <h6 class="mt-2">No Administrators Found</h6>

                                                            <p class="text-secondary mb-0">
                                                                Add your first administrator.
                                                            </p>

                                                        </td>
                                                    </tr>

                                                    <% } %>

                                </tbody>

                            </table>

                        </div>

                    </div>
                </div>

            </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>